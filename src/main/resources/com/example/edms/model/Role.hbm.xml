<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.example.edms.model">
    
    <class name="Role" table="roles">
        <id name="id" column="id">
            <generator class="identity"/>
        </id>
        
        <property name="name" column="name" not-null="true" unique="true" length="50"/>
        <property name="description" column="description" length="255"/>
        <property name="isSystemRole" column="is_system_role" type="boolean"/>
        <property name="createdAt" column="created_at" type="timestamp" not-null="true"/>
        <property name="updatedAt" column="updated_at" type="timestamp" not-null="true"/>
        
        <!-- Many-to-many relationship with Permission -->
        <set name="permissions" table="role_permissions" lazy="true" fetch="select">
            <key column="role_id"/>
            <many-to-many class="Permission" column="permission_id"/>
        </set>
        
        <!-- Many-to-many relationship with User (inverse side) -->
        <set name="users" table="user_roles" lazy="true" fetch="select" inverse="true">
            <key column="role_id"/>
            <many-to-many class="User" column="user_id"/>
        </set>
    </class>

</hibernate-mapping>
